# Example environment file. Copy to .env and fill in values.
# OpenAI (optional)
OPENAI_API_KEY=

# Anthropic (optional)
ANTHROPIC_API_KEY=

# Gemini (optional)
GEMINI_API_KEY=

# HuggingFace (optional, for gated models)
HUGGINGFACE_API_KEY=

# Override LLM provider
LLM_PROVIDER=gemini
LLM_MODEL_NAME=gemini-2.5-flash